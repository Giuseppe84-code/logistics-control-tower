# Copy this file to `.env.local` and fill in your own values.
# See supabase/SETUP.md for where to find each value.

# ─── Supabase (Phase 1, required) ───────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Stripe (Phase 4, billing) ──────────────────────────────────────────────
# Find your keys at: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=
# Price ID created for the Pro monthly plan (€9/month)
VITE_STRIPE_PRICE_ID=
